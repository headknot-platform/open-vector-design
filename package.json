        "node": ">=22.13"
    },
    "pnpm": {
        "overrides": {
            "react": "19.1.9",
            "react-dom": "19.1.9"
        },
        "onlyBuiltDependencies": [
            "@tailwindcss/oxide",
            "esbuild"
        ]
    }
