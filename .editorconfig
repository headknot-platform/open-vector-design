root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# OVD files follow the spec's canonical form (§10): 2-space indentation.
[examples/**/*.{svg,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
